# Copy to .env and fill in. .env is gitignored
#   cp .env.example .env
#
# Compose reads this file automatically. So does the local notebook, via
# python-dotenv in src/config.py.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# Host and port: the one thing worth understanding before the first run.
#
# The database has two addresses, and which is correct depends entirely on
# where the code is running:
#
#   From Windows (notebook, DBeaver, psql)  ->  localhost:5433
#   From inside the container (train)       ->  host.docker.internal:5433
#
# Same database, same port. Only the hostname differs, because "localhost"
# inside a container means the container itself, not your machine.
#
# The value below is the LOCAL one, since .env is what the notebook reads.
# docker-compose.yml overrides POSTGRES_HOST to host.docker.internal for the
# train service, so the container is correct regardless of what is set here.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
