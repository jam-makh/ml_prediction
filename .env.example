# Copy to .env and fill in; .env is gitignored.
# Compose reads it automatically, and the local notebook reads it via python-dotenv.

# ---------------------------------------------------------------------------
# Business database (cleaning-postgres container, already running on the host)
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=training

# Local address for the notebook; compose overrides the host to host.docker.internal.
# "localhost" inside a container means the container itself, not your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
# Credentials for airflow_postgres, Airflow's own metadata database.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Encrypts connection passwords stored in the metadata database.
# Generate: docker run --rm apache/airflow:3.2.0-python3.13 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Signs login tokens; every Airflow component must share the same value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=

# UI login, created once by airflow_init.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Optional DAG overrides of ml_config.yaml's serving.orchestration; leave empty to use the config.
# Minutes the run_predictions task may run.
PREDICT_TIMEOUT_MINUTES=
# Cron for the retrain DAG's floor, e.g. "0 * * * *" (hourly) in a test environment.
RETRAIN_SCHEDULE=
